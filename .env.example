# Ryport Environment Configuration

# === Supabase Configuration ===
# Get these from your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# === AI Configuration ===
# API key for Lovable AI gateway integration
# Store securely - never commit actual key to repository
LOVABLE_API_KEY=your_lovable_api_key

# === Server Configuration ===
# Port for development server (default: 3000)
# port=3000

# === Security Configuration ===
# CSRF token secret (generate a strong random string for production)
CSRF_SECRET=your_csrf_secret_key

# Session configuration
SESSION_SECRET=your_session_secret_key

# === Logging ===
# Log level: debug, info, warn, error
LOG_LEVEL=info

# === Feature Flags ===
# Enable/disable features during development
ENABLE_DEBUG_MODE=false
ENABLE_ADMIN_FEATURES=true

# === Database ===
# Connection pooling settings for Supabase
# DATABASE_CONNECTION_POOL_SIZE=10

# === Email Configuration (Optional) ===
# For email notifications and account recovery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password

# === Monitoring & Error Tracking (Optional) ===
# Sentry or similar error tracking service
# SENTRY_DSN=https://your_sentry_dsn

# === Third-party Integrations ===
# Add any other service credentials here
# Keep sensitive values in .env.local (gitignored)
